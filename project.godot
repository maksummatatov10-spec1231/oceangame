; Ocean Voyage — Godot 4.3
config_version=5

[application]
config/name="Ocean Voyage"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input]
throttle={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]}
reverse={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]}
turn_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]}
turn_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]}
boost={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
restart={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":82)]}


weather_calm={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
weather_breeze={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
weather_storm={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":51)]
}

[shader_globals]
